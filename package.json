{
  "name": "piproof",
  "version": "0.19.0",
  "description": "Deterministic reference implementation of Programmable Engagement Proofs (PEP): canonical schemas, Ed25519-signed activity payloads, replay protection, bounded weights, decentralized arbitration court, and a multi-language SDK family (Node, Python, Go, Rust, WASM) verified against public interop vectors.",
  "type": "module",
  "author": {
    "name": "EslaM-X",
    "url": "https://github.com/EslaM-X"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EslaM-X/piproof.git"
  },
  "bugs": {
    "url": "https://github.com/EslaM-X/piproof/issues"
  },
  "homepage": "https://github.com/EslaM-X/piproof#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "pep": "./src/cli.js",
    "piproof": "./src/cli.js"
  },
  "files": [
    "src/",
    "docs/",
    "vectors/",
    "sdk/python/piproof_sdk.py",
    "sdk/python/pyproject.toml",
    "sdk/python/README.md",
    "sdk/python/test_sdk.py",
    "sdk/go/*.go",
    "sdk/go/cmd/**/*.go",
    "sdk/rust/src/",
    "sdk/rust/tests/",
    "wasm/main.go",
    "wasm/README.md",
    "SPEC.md",
    "ADOPTERS.md",
    "SECURITY_REVIEW.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./canonical": "./src/canonical.js",
    "./events": "./src/events.js",
    "./verify": "./src/verify.js",
    "./registry": "./src/registry.js",
    "./policy": "./src/policy.js",
    "./passport": "./src/passport.js",
    "./piproof": "./src/piproof.js",
    "./dispute": "./src/dispute.js",
    "./court": "./src/court.js",
    "./agent-evidence": "./src/agent-evidence.js",
    "./nonces": "./src/nonces.js",
    "./constants": "./src/constants.js",
    "./transparency": "./src/transparency.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test",
    "attacks": "node src/cli.js attacks",
    "demo": "node src/cli.js demo",
    "transparency": "node scripts/transparency-demo.mjs",
    "app": "node app/server.mjs",
    "bench": "node scripts/bench.mjs",
    "gen:snapshot": "node scripts/gen-snapshot.mjs",
    "gen:vectors": "node scripts/gen-vectors.mjs && node scripts/check-vectors.mjs",
    "gen:canonical": "node scripts/gen-canonical-vectors.mjs && node scripts/check-canonical-vectors.mjs",
    "cross:python": "python scripts/cross-verify.py && python scripts/cross-canonical.py",
    "layers": "node scripts/check-layers.mjs",
    "fuzz": "node scripts/fuzz.mjs",
    "fuzz:quick": "node scripts/fuzz.mjs --quick",
    "conformance": "node scripts/conformance.mjs",
    "ci": "npm run layers && npm test && npm run attacks && npm run transparency && npm run gen:vectors && npm run gen:canonical && npm run fuzz:quick && npm run conformance"
  },
  "keywords": [
    "aurevia",
    "pirc",
    "pep",
    "ed25519",
    "canonical-json",
    "replay-protection",
    "sybil-resistance",
    "piproof",
    "trust-policy"
  ],
  "license": "SEE LICENSE IN LICENSE"
}
